{
  "name": "mohafzaty-pro",
  "productName": "محفظتي برو",
  "version": "2.2.0",
  "description": "محفظتي برو - نسخة Windows",
  "main": "main.js",
  "author": "Mohafzaty Pro",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "pro.mohafzaty.app",
    "productName": "محفظتي برو",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
